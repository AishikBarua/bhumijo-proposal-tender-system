# Copy this file to .env and edit. Nothing here belongs in the code.

BHUMIJO_ENV=production

# --- network ---------------------------------------------------------
BHUMIJO_HOST=0.0.0.0
BHUMIJO_PORT=8787

# Which web addresses may call this server. Comma separated, no "*".
# Leave blank for same-origin only (the normal case when the server
# also serves the screens).
BHUMIJO_CORS_ORIGINS=

# --- storage ---------------------------------------------------------
# BHUMIJO_DATA_DIR=D:\Tracker\bhumijo_system\data
# Where nightly backups are written. Point this at a DIFFERENT disk.
# BHUMIJO_BACKUP_DIR=E:\BhumijoBackups
# The old JSONL folder, read once by the migration script.
# BHUMIJO_LEGACY_DATA_DIR=D:\Tracker\proposal_backups

# --- security --------------------------------------------------------
# Let devices on the office network in without the access token, so nobody
# has to type anything. Anyone who can reach this PC on your local network
# can then read and edit every record, with no password.
#
# Only PRIVATE addresses are trusted (192.168.x, 10.x, 172.16-31.x, and this
# PC). A request from a public address still needs the token, so this does
# not expose anything to the internet.
#
# Set this to false to require the access token again.
BHUMIJO_TRUST_LOCAL_NETWORK=true

BHUMIJO_SESSION_HOURS=12
# Deleting is restricted to the server PC until roles replace it.
BHUMIJO_DELETE_LOCALHOST_ONLY=true

# --- logging ---------------------------------------------------------
BHUMIJO_LOG_LEVEL=INFO
